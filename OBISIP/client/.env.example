# Copy this file to .env.local for local development
# For Vercel — set these in: Vercel Dashboard → Project → Settings → Environment Variables

# The deployed backend URL (your Vercel backend project URL)
# Example: https://pizzahub-api.vercel.app/api
VITE_API_URL=https://your-backend.vercel.app/api

# The deployed backend WebSocket URL (same domain, no /api suffix)
# Example: https://pizzahub-api.vercel.app
VITE_WS_URL=https://your-backend.vercel.app
